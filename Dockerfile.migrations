# docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.migrations -t swifts32/magnolia-migrations:latest --no-cache --push .

FROM oven/bun:1-alpine AS migrations

WORKDIR /app

# Copy lock files
COPY package.json bun.lock ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy migrations folder & migration runner script
COPY ./src/lib/server/db/migrations ./migrations
COPY migrate.ts ./migrate.ts

ENV NODE_ENV=production

# Run the migration script directly with Bun
CMD ["bun", "run", "migrate.ts"]